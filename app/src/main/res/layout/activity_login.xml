<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/screen">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="42dp"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp"
        android:focusableInTouchMode="true">

        <TextView android:layout_width="86dp" android:layout_height="86dp"
            android:layout_gravity="center_horizontal" android:gravity="center"
            android:background="@drawable/login_mark" android:text="@string/login_mark"
            android:textColor="@color/on_primary" android:textStyle="bold" android:textSize="34sp" />
        <TextView style="@style/ScreenTitle" android:gravity="center"
            android:layout_marginTop="22dp" android:text="@string/app_name" />
        <TextView style="@style/BodyText" android:gravity="center" android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" android:textColor="@color/text_secondary"
            android:text="@string/login_subtitle" />

        <TextView style="@style/FieldLabel" android:labelFor="@id/username" android:text="@string/username" />
        <EditText
            android:id="@+id/username"
            style="@style/FieldInput"
            android:hint="@string/username"
            android:inputType="text"
            android:imeOptions="actionNext" />
        <TextView style="@style/FieldHelp" android:text="@string/help_login_0" />

        <TextView style="@style/FieldLabel" android:labelFor="@id/password" android:text="@string/password" />
        <EditText
            android:id="@+id/password"
            style="@style/FieldInput"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:imeOptions="actionDone" />
        <TextView style="@style/FieldHelp" android:text="@string/help_login_1" />

        <TextView
            android:id="@+id/login_error"
            style="@style/BodyText"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/error"
            android:visibility="gone" />

        <Button android:id="@+id/login_button" style="@style/PrimaryButton" android:text="@string/login_title" />
    </LinearLayout>
</ScrollView>
